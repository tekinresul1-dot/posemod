generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  role           UserRole @default(USER)
  credits        Float    @default(0)
  pendingCredits Float    @default(0)
  plan           String   @default("free")
  createdAt      DateTime @default(now())
  generations    Generation[]
  transactions   CreditTransaction[]
  payments       Payment[]
}

model Generation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  jobId       String    @unique
  type        String
  status      String    @default("pending")
  creditCost  Float
  productName String?
  prompt      String?
  negPrompt   String?
  quality     String    @default("1k")
  inputUrls   String[]
  outputUrls  String[]
  mannequinId         String?
  errorMsg            String?
  parentGenerationId  String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
}

model Mannequin {
  id                String   @id @default(cuid())
  name              String
  gender            String   @default("")
  ethnicity         String?
  previewUrl        String   @default("")
  userId            String   @default("")
  prompt            String   @default("")
  ageRange          String?
  height            String?
  size              String?
  skinTone          String?
  hairColor         String?
  hairLength        String?
  eyeColor          String?
  customPrompt      String?
  referencePhotoUrl String?
  backgroundUrl     String?
  poseData          Json?
  createdFrom       String   @default("manual")
  isSystem          Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  type      String
  reference String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([type, reference])
  @@index([userId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  provider    String        @default("paytr")
  merchantOid String        @unique
  packageId   String
  amountTRY   Float
  credits     Float
  status      PaymentStatus @default(pending)
  rawCallback Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  paidAt      DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
